# Скопіюй цей файл у .env і заповни реальними значеннями перед запуском.

# Порт, на якому слухає сервер (хостинг зазвичай підставляє свій — лишай як є)
PORT=3000

# Довгий випадковий рядок для підпису cookie-сесій. Згенерувати можна так:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Пароль для входу в /admin (панель перевірки завдань). Онови на щось надійне.
ADMIN_PASSWORD=change-me

# production вмикає Secure-cookie (працює лише по https) і вимагає SESSION_SECRET
NODE_ENV=production

# Необов'язково: куди писати файл SQLite. За замовчуванням ./data/grivnya.db
# DB_PATH=/var/data/grivnya.db
